$(document).ready(function () {
    $('.slider_image').bjqs({
        height: 351,
        width: 707,
        responsive: true
    });
    
    $('.rules_and_regulation_button').click(function (){
		$('#rules_and_regulation').modal();
		return false;
	 });

	 $('.gallery_image_number').click(function (){
		var image_zoom = $(this).attr('id');	
	 	$('#'+image_zoom+'_big').modal();
		return false;
	 });
	 
	 var = zoom_plus_id;
	 $('.gallery_image_number').mouseover(function(){
	 	zoom_plus_id = $(this).attr('id');
